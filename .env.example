# Clé Albert, à renseigner uniquement dans le fichier .env local ou sur Vercel.
ALBERT_API_KEY=

# Génération de la dictée, des mots mêlés et de la vitesse de lecture.
ALBERT_MODEL=mistral-small-3-2-24b-instruct-2506

# Génération des questions de compréhension.
ALBERT_COMPREHENSION_MODEL=gemma-4-31b-it

# Code demandé dans le studio enseignant.
STUDIO_CODE=

# Décommentez pour tester le studio sans appeler Albert.
# ALBERT_MOCK=1

# Optionnel : publication directe depuis le studio.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
